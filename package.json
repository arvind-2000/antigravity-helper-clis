{
  "name": "flutter-agent-kit",
  "version": "1.0.0",
  "description": "Production-quality CLI to install, maintain, and audit Antigravity Flutter/Dart engineering configurations, rules, workflows, and skills.",
  "type": "module",
  "bin": {
    "flutter-agent": "./dist/bin/flutter-agent.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('./dist/bin/flutter-agent.js', 0o755))\"",
    "start": "node ./dist/bin/flutter-agent.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "flutter",
    "dart",
    "antigravity",
    "cli",
    "agent",
    "engineering",
    "rules",
    "skills",
    "workflows"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
